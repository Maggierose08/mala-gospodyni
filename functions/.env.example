# Copy this file to .env.mala-gospodyni (the project-id-specific name
# Cloud Functions looks for automatically) once you're ready to go live --
# see README.md in this folder for the full checklist. Never commit the
# real copy (the .gitignore in this folder already excludes .env.* except
# this example file).

# Master off-switch. Leave this as "false" (or just delete the line) until
# Premium is real and you're ready for new signups to start receiving this
# email. The function checks this itself, so even an accidental early
# deploy of this folder sends nothing.
PREMIUM_EMAIL_ENABLED=false

# From resend.com, after creating a free account -- functions/README.md
# walks through this.
RESEND_API_KEY=

# Must be on a domain you've verified with Resend (not a free
# onboarding@resend.dev test address, and not a plain gmail.com address --
# Resend won't let you send real mail "from" either of those).
# e.g. RESEND_FROM_ADDRESS="Mala Gospodyni <hello@yourdomain.com>"
RESEND_FROM_ADDRESS=
