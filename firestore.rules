rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Users: each person's own profile (username, contact info, avatar) ----
    match /users/{userId} {
      // A user can always read their own profile; the admin can also read
      // anyone's, so the "Grant free access" screen can show a person's
      // avatar/username/contact info before free access is actually
      // granted, and so the granted-list can show current avatars.
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.email == "malagospodyni@gmail.com");
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Self-serve account deletion cleans up this doc itself (after
      // re-authenticating and deleting everything it owns) -- only the
      // account itself can do this, never anyone else.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ---- A user's own private recipes ----
      match /recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ---- A user's own meal plan (one doc per calendar day) ----
      match /mealPlan/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ---- Recipes a friend has sent this account directly (Friends &
      // Family sharing) -- a one-way inbox: only the recipient can ever
      // read or clear it, but ANY signed-in user can drop a new recipe in,
      // the same way anyone can hand someone a recipe card in person.
      // request.resource.data.fromUid must match the sender's own uid, so
      // a share always shows who it's really from.
      match /sharedWithMe/{shareId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
        allow update: if false;
      }
    }

    // ---- Username -> uid lookup, used to keep usernames unique ----
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- Email -> uid lookup, so Friends & Family can find someone by
    // either their username or their email. Same trust shape as usernames
    // above, except the document id must match the requester's OWN verified
    // email (Firebase Auth's token.email, not anything the client sends) --
    // so an account can only ever create or remove the mapping for its own
    // email, never claim or steal someone else's. ----
    match /emailLookup/{emailKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email != null
        && emailKey == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- Public profile mirror (username + avatar ONLY -- never email or
    // contact info) -- lets any signed-in user look a friend up by
    // username for Friends & Family sharing, without exposing anything
    // private. Kept in sync with "users/{uid}" by the app itself whenever
    // the username or avatar changes. ----
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Free ("comped") access grants for friends & family -- admin-managed ----
    match /grants/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.email == "malagospodyni@gmail.com");
      allow write: if request.auth != null && request.auth.token.email == "malagospodyni@gmail.com";
      // An account can also remove its OWN grant doc (only), as part of
      // deleting itself -- this can only revoke free access from yourself,
      // never touch anyone else's, so it doesn't weaken the admin-only
      // grant/revoke rule above.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Community Recipes: a public pool anyone can browse ----
    match /communityRecipes/{docId} {
      // Anyone can browse the shared pool, signed in or not.
      allow read: if true;

      // Only a signed-in user can publish/update their own recipe, and only
      // under the id format the app uses (<their uid>_<their recipe id>) --
      // this keeps someone from writing into another user's document.
      allow create, update: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.sourceRecipeId;

      // Only the original author (or the admin) can remove a shared copy --
      // the admin case covers the "Remove Recipe" button on the Review
      // Reports screen.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid
            || request.auth.token.email == "malagospodyni@gmail.com");

      // ---- Comments left on this community recipe ----
      match /comments/{commentId} {
        // Anyone can read comments, signed in or not; only a signed-in user
        // can post one, and only as themselves.
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;

        // A comment can be removed by whoever wrote it, by the author of
        // the recipe it's on, or by the admin.
        allow delete: if request.auth != null
          && (resource.data.authorUid == request.auth.uid
              || get(/databases/$(database)/documents/communityRecipes/$(docId)).data.authorUid == request.auth.uid
              || request.auth.token.email == "malagospodyni@gmail.com");
      }
    }

    // ---- Reports filed against a community recipe ----
    match /reports/{reportId} {
      // Anyone signed in can file a report. Only the admin can read, list,
      // or remove reports -- through the in-app "Review Reports" screen
      // (Profile -> Community moderation), which dismisses a report or
      // deletes the reported recipe and its report together. Reports are
      // never editable, by anyone, including the admin.
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.token.email == "malagospodyni@gmail.com";
      allow update: if false;
    }
  }
}
